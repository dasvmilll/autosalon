# ============================================
# Пример файла переменных окружения для продакшена
# Скопируйте этот файл в .env и заполните реальными значениями
# ============================================

# Секретный ключ Django (генерируется командой: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=your-super-secret-key-here-change-in-production

# Режим отладки (False для продакшена)
DEBUG=False

# Разрешённые хосты (домены, с которых можно обращаться к сайту)
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# База данных (для продакшена рекомендуется PostgreSQL)
DB_NAME=autosalon
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432

# Email (SMTP для отправки уведомлений)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True